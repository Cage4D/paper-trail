// Paper Trail API data model (spec §7.2, amended by decisions D2–D4).
// The server stores only public data, ciphertexts, sealed envelopes and hashes.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ExamStatus {
  PENDING // relay queued / in flight
  CREATED // ExamCreated indexed
  FAILED
}

enum Role {
  INVIGILATOR
  MARKER
}

enum MarksStatus {
  OPEN
  PUBLISHING // publishMarks relayed / in flight: marking frozen (bug-hunt finding 6)
  PUBLISHED
}

enum RelayStatus {
  QUEUED
  SUBMITTED
  CONFIRMED
  FAILED
}

/// A Paper Trail role key (D2: SIWQ is signed by the role key). qorexAddress is bound later.
model User {
  id           String   @id @default(cuid())
  roleAddress  String   @unique // qor1…
  evmAddress   String   @unique // 0x… (lower-case)
  qorexAddress String?  @unique
  bindTx       String? // QoreX self-transfer carrying the binding memo
  bindStatementHash String?
  bindRelayTx  String? // PaperTrail.bindIdentity
  sealCard     Json? // signed QoreSeal recipient card (public)
  createdAt    DateTime @default(now())
}

/// SIWQ nonces issued by POST /auth/siwq/challenge (single use, short-lived).
model AuthChallenge {
  nonce     String    @id
  address   String
  message   String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model Exam {
  id               String     @id @default(cuid())
  onchainId        String     @unique // examIdFor(board, salt)
  salt             String
  title            String
  boardAddr        String // 0x… lower-case
  examiners        String[] // 0x… lower-case, contract order
  startTime        DateTime
  masterCommitment String
  committeeBlob    Bytes
  committeeHash    String
  createTx         String?
  status           ExamStatus @default(PENDING)
  marksStatus      MarksStatus @default(OPEN)
  marksRoot        String?
  marksTx          String?
  marksSnapshot    Json? // the exact entries the root was built from
  centres          Centre[]
  createdAt        DateTime   @default(now())
}

model Centre {
  id           String  @id @default(cuid())
  examId       String
  exam         Exam    @relation(fields: [examId], references: [id])
  onchainId    String
  name         String
  commitment   String
  cipherBlob   Bytes
  cipherHash   String
  setTx        String?
  confirmed    Boolean @default(false) // CentreSet indexed
  currentEpoch Int     @default(0)
  released     Boolean @default(false)

  @@unique([examId, onchainId])
}

model Member {
  id           String  @id @default(cuid())
  boardAddr    String
  groupKey     String
  role         Role
  address      String
  active       Boolean @default(true)
  addedEpoch   Int
  removedEpoch Int?

  @@index([boardAddr, groupKey, active])
}

/// One row per (board, group, epoch), written BEFORE relaying rotateEpoch and confirmed by the
/// indexed EpochChanged event (bug-hunt findings 2/3): the members of the epoch the chain is at
/// are the group's current members.
model EpochEnvelope {
  id           String   @id @default(cuid())
  boardAddr    String
  groupKey     String
  groupChainId String
  epoch        Int
  envelope     Bytes
  membersHash  String
  members      String[] // 0x… lower-case, the full member list of this epoch
  added        String[]
  removed      String[]
  role         Role     @default(INVIGILATOR)
  confirmed    Boolean  @default(false) // EpochChanged indexed with this membersHash
  txHash       String?
  createdAt    DateTime @default(now())

  @@unique([boardAddr, groupKey, epoch])
}

model BoardState {
  boardAddr   String   @id
  sealedState Bytes
  updatedAt   DateTime @updatedAt
}

model ShareBlob {
  id               String  @id @default(cuid())
  examId           String
  centreId         String
  examinerAddr     String
  examinerIndex    Int
  sealedToExaminer Bytes
  releasedBlob     Bytes?
  releasedEpoch    Int?
  releaseTx        String?

  @@unique([examId, centreId, examinerAddr])
}

model Script {
  id            String  @id @default(cuid())
  examId        String
  centreId      String
  pseudonymHash String
  blob          Bytes
  scriptHash    String
  markerEpoch   Int
  txHash        String?
  createdAt     DateTime @default(now())

  @@unique([examId, pseudonymHash])
}

model Mark {
  id             String @id @default(cuid())
  scriptId       String
  markerAddr     String
  score          Int
  sealedFeedback Bytes?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([scriptId, markerAddr])
}

/// QoreX binding nonces (D2): the memo the user's QoreX self-transfer must carry.
model BindChallenge {
  nonce     String    @id
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

model IdentityMap {
  examId String @id
  blob   Bytes
}

model ChainEvent {
  id          String   @id @default(cuid())
  name        String
  examId      String?
  centreId    String?
  data        Json
  txHash      String
  blockNumber BigInt
  logIndex    Int
  createdAt   DateTime @default(now())

  @@unique([txHash, logIndex])
  @@index([examId])
}

/// Catch-up-on-read indexer position (D3: no long-running watcher on Vercel).
model IndexerCursor {
  id        String   @id // contract address
  lastBlock BigInt
  updatedAt DateTime @updatedAt
}

model RelayJob {
  id        String      @id @default(cuid())
  ref       String? // what the job is for, e.g. "centre:<examId>:<centreId>" (retries, reconciliation)
  examId    String?
  action    String
  signer    String
  payload   Json
  status    RelayStatus
  txHash    String?
  error     String?
  attempts  Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([ref])
  @@index([status])
}

/// Board-issued, single-use admission tickets for script submission (bug-hunt finding 5).
model ScriptTicket {
  tokenHash String    @id // SHA3-256 of the ticket
  examId    String
  centreId  String
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([examId])
}

/// Fixed-window rate limits shared by every serverless instance (bug-hunt finding 5).
model RateLimit {
  key         String   @id
  windowStart DateTime
  count       Int
}
