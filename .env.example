# Paper Trail — environment (spec §9). Copy to .env and fill in locally.
# NEVER commit .env. Testnet only: qorechain-diana, EVM chain id 9800.

# Postgres. Locally: a throwaway cluster; in production: the Vercel-managed DB.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:54329/papertrail?schema=public

# QoreChain testnet endpoints (defaults from @qorechain/sdk getNetwork("testnet")).
QORE_REST=https://api-testnet.qore.host
QORE_RPC=
EVM_RPC=https://evm-testnet.qore.host
CHAIN_ID=9800

# Deployed PaperTrail.sol (Phase 2).
PAPERTRAIL_ADDRESS=

# Relayer account: holds the EVM window and pays gas. BIP-39 mnemonic.
RELAYER_MNEMONIC=

# Demo role accounts for judge mode (DEMO, testnet only), JSON object
# role -> BIP-39 mnemonic: board, examiner1..3, invigilatorA1, invigilatorA2,
# invigilatorB1, marker1, marker2.
DEMO_MNEMONICS=

# API
ADMIN_TOKEN=
JWT_SECRET=
CORS_ORIGIN=http://localhost:3000
